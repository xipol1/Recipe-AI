# Production environment template
NODE_ENV=production
PORT=5000

# Required secrets
MONGODB_URI=mongodb://prod-host:27017/plataforma_monetizacion
JWT_SECRET=replace_with_production_jwt_secret
JWT_REFRESH_SECRET=replace_with_production_refresh_secret
SESSION_SECRET=replace_with_production_session_secret
ENCRYPTION_KEY=replace_with_32_char_production_encryption_key

# Security and auth
CORS_ORIGINS=https://app.example.com
ENABLE_DEMO_USERS=false

# Optional integrations
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_USER=
EMAIL_PASS=
