# Staging environment template
NODE_ENV=staging
PORT=5000

# Required secrets
MONGODB_URI=mongodb://staging-host:27017/plataforma_monetizacion_staging
JWT_SECRET=replace_with_staging_jwt_secret
JWT_REFRESH_SECRET=replace_with_staging_refresh_secret
SESSION_SECRET=replace_with_staging_session_secret
ENCRYPTION_KEY=replace_with_32_char_staging_encryption_key

# Security and auth
CORS_ORIGINS=https://staging.frontend.example.com
ENABLE_DEMO_USERS=true
DEMO_USER_EMAIL=demo@adflow.com
DEMO_USER_PASSWORD=123456
DEMO_CREATOR_EMAIL=creator@adflow.com
DEMO_CREATOR_PASSWORD=123456

# Optional integrations
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_USER=
EMAIL_PASS=
